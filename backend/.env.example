# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real credentials.

DATABASE_URL="mysql://user:password@localhost:3306/altrium_hr"
JWT_SECRET="replace-with-a-long-random-string"

# Only needed once deployed -- password-reset emails link back to this URL.
# Leave unset for local dev (defaults to http://localhost:5173, where Vite
# serves the frontend). In production, set this to your deployed frontend
# origin (e.g. the Render URL from docs/cloud-deployment-guide.md).
FRONTEND_URL=

# ---- Email delivery (optional) ----
# Leave all 5 of these blank and the app falls back to logging emails to the
# console instead of sending them -- everything else keeps working, useful
# for local dev/demos where nobody wants to configure a mail account.
#
# Option A: Outlook / Microsoft 365 personal or work account
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-account@outlook.com
#   SMTP_PASS=your-account-password        (or an app password if MFA is on)
#   MAIL_FROM=your-account@outlook.com
#
# Option B: Gmail
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=your-16-character-app-password   (Gmail requires an App Password,
#                                                not your normal login password --
#                                                generate one under Google
#                                                Account > Security > App passwords,
#                                                only available with 2-Step
#                                                Verification turned on)
#   MAIL_FROM=your-account@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
