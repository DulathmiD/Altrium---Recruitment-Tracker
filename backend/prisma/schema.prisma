generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  HR
  INTERVIEWER
  MANAGEMENT
  HIRING_MANAGER
  IT_ADMIN
  LEADERSHIP_MANAGEMENT
}

enum VacancyStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  IN_PROGRESS
  HIRED
}

enum HiringDecision {
  HIRE
  REJECT
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role
  department          String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  feedbackGiven      Feedback[]
  panelistOn         InterviewPanelist[]
  decisionsMade      CandidateApplication[] @relation("DecidedBy")
  feedbackEdits      FeedbackAuditLog[]
  cvReviews          Candidate[]            @relation("LastCvReviewedBy")
  assignedHmOn       CandidateApplication[] @relation("AssignedHiringManager")
}

model Vacancy {
  id              Int           @id @default(autoincrement())
  title           String
  department      String
  description     String        @db.Text
  requirements    String?
  preferredSkills String?
  status          VacancyStatus @default(OPEN)
  createdAt       DateTime      @default(now())

  stages       VacancyStage[]
  applications CandidateApplication[]
}

model VacancyStage {
  id        Int     @id @default(autoincrement())
  vacancyId Int
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id])
  name      String
  order     Int

  interviews          Interview[]
  applicationsAtStage CandidateApplication[]

  @@unique([vacancyId, order])
}

model Candidate {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phoneNumber String?
  cvUrl     String
  createdAt DateTime @default(now())

  lastCvReviewedByUserId Int?
  lastCvReviewedBy       User?     @relation("LastCvReviewedBy", fields: [lastCvReviewedByUserId], references: [id])
  lastCvReviewedAt       DateTime?

  applications CandidateApplication[]
}

model CandidateApplication {
  id          Int               @id @default(autoincrement())
  candidateId Int
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  vacancyId   Int
  vacancy     Vacancy           @relation(fields: [vacancyId], references: [id])
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())

  currentStageId Int?
  currentStage   VacancyStage? @relation(fields: [currentStageId], references: [id])

  hiringDecision  HiringDecision?
  decidedByUserId Int?
  decidedBy       User?           @relation("DecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?

  hiringManagerId Int?
  hiringManager   User? @relation("AssignedHiringManager", fields: [hiringManagerId], references: [id])

  interviews Interview[]

  @@unique([candidateId, vacancyId])
}

model Interview {
  id            Int                  @id @default(autoincrement())
  applicationId Int
  application   CandidateApplication @relation(fields: [applicationId], references: [id])
  stageId       Int
  stage         VacancyStage         @relation(fields: [stageId], references: [id])
  scheduledAt   DateTime
  createdAt     DateTime             @default(now())

  panelists InterviewPanelist[]
  feedback  Feedback[]
}

model InterviewPanelist {
  id          Int       @id @default(autoincrement())
  interviewId Int
  interview   Interview @relation(fields: [interviewId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@unique([interviewId, userId])
}

model Feedback {
  id            Int       @id @default(autoincrement())
  interviewId   Int
  interview     Interview @relation(fields: [interviewId], references: [id])
  interviewerId Int
  interviewer   User      @relation(fields: [interviewerId], references: [id])
  score         Int
  comments      String    @db.Text
  createdAt     DateTime  @default(now())

  auditLog FeedbackAuditLog[]

  @@unique([interviewId, interviewerId])
}

model FeedbackAuditLog {
  id               Int      @id @default(autoincrement())
  feedbackId       Int
  feedback         Feedback @relation(fields: [feedbackId], references: [id])
  editedByUserId   Int
  editedBy         User     @relation(fields: [editedByUserId], references: [id])
  previousScore    Int
  previousComments String   @db.Text
  newScore         Int
  newComments      String   @db.Text
  reason           String   @db.Text
  editedAt         DateTime @default(now())
}